{
  "name": "pos-club-padel",
  "author": "Pádel Argonos",
  "version": "0.8.0",
  "private": true,
  "description": "Demo de punto de venta interno para el club de padel",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "test": "electron pruebas/e2e.js",
    "demo": "electron pruebas/demo.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.6.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "es.argonos.padel.caja",
    "productName": "Caja Pádel Argonos",
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "files": ["electron-main.js", "server.js", "public/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [{ "from": "initial-pos.db", "to": "initial-pos.db" }],
    "directories": { "output": "dist" },
    "publish": [{ "provider": "github", "owner": "padelargonosclub-cpu", "repo": "appcobrar", "releaseType": "release" }],
    "win": {
      "target": "nsis",
      "icon": "public/assets/argonos-icon-512.png",
      "artifactName": "Caja-Padel-Argonos-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Caja Pádel Argonos",
      "deleteAppDataOnUninstall": false
    }
  }
}
